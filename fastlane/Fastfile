default_platform :ios

platform :ios do
    desc "Create signing certs and provisioning profiles if needed"
    lane :signing do
        cert(team_id: "79RY8264V4", development: true)
        sigh(team_id: "79RY8264V4", app_identifier: "me.syan.TorrentAdder", development: true, force: true,
            provisioning_name: "me.syan.TorrentAdder Development")
        sigh(team_id: "79RY8264V4", app_identifier: "me.syan.TorrentAdder", development: true, platform: 'catalyst', force: true,
            provisioning_name: "me.syan.TorrentAdder Development macOS")

        cert(team_id: "79RY8264V4")
        sigh(team_id: "79RY8264V4", app_identifier: "me.syan.TorrentAdder", adhoc: true, force: true,
            provisioning_name: "me.syan.TorrentAdder AdHoc")
        sigh(team_id: "79RY8264V4", app_identifier: "me.syan.TorrentAdder", platform: 'catalyst', force: true,
            provisioning_name: "me.syan.TorrentAdder AppStore macOS")

        system "rm ../*.provisionprofile"
        system "rm ../*.mobileprovision"
        system "rm ../*.cer"
        system "rm ../*.p12"
        system "rm ../*.certSigningRequest"
    end

    def promptIncrementBuild
        if UI.confirm("Do you want to increase the build number before building the apps?")
            increment_build_number
        end
    end

    desc "Submit a new build"
    lane :ota do
        promptIncrementBuild

        # build iOS version
        build_ios_app(
          export_method: "ad-hoc"
        )

        # upload it
        Dir.chdir("..") do
            system("unzip -p build/Magneto.ipa Payload/Magneto.app/Info.plist > build/Magneto.plist")
            system("plutil -convert xml1 build/Magneto.plist")
            system("deploy_ota build/Magneto.ipa build/Magneto.plist")
        end

        # build macOS version
        build_mac_app(
            export_method: "developer-id",
            export_options: {
                provisioningProfiles: {
                    "me.syan.TorrentAdder" => "me.syan.TorrentAdder DeveloperID"
                }
            }
        )
    end
end
